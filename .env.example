APP_NAME=UCC Ethical Clearance Portal
SECRET_KEY=replace-with-a-long-random-secret
# Local development:
DATABASE_URL=sqlite:///./ucc_irb.db
# Production PostgreSQL is accepted as postgresql://... or postgres://...
# and is automatically normalized to postgresql+psycopg://... for Psycopg 3.
STORAGE_DIR=./storage
SESSION_HTTPS_ONLY=false
PORT=8000
